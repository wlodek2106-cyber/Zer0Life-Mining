# Telegram bot token (set only in backend environment; never commit the real token)
BOT_TOKEN=replace_with_botfather_token
ADMIN_TELEGRAM_IDS=

# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/zerolife_mining

# Solana read-only RPC (Helius is used when HELIUS_API_KEY is set and SOLANA_RPC_URL is blank)
HELIUS_API_KEY=replace_with_helius_api_key
SOLANA_RPC_URL=
SOLANA_COMMITMENT=confirmed
ZRL_TOKEN_MINT=GPJjF6w38TYrNFUSkZSctW1dSoZSiu8CSFjgygjdtzuo
ZRL_TOKEN_DECIMALS=6
TREASURY_WALLET_ADDRESS=
TREASURY_MIN_ZRL_ALERT=100000

# Virtual mining pool allocations
MINING_POOL_TOTAL_ZRL=100000000
MINING_REWARDS_ALLOCATION_ZRL=70000000
MINING_FUTURE_SEASONS_RESERVE_ZRL=20000000
MINING_ACTIVITY_BONUSES_ZRL=10000000

# Background reports and pool alerts (single-process MVP workers)
DAILY_REPORT_ENABLED=false
DAILY_REPORT_HOUR_UTC=20
MINING_POOL_ALERTS_ENABLED=false
